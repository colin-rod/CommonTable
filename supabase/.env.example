# Supabase Configuration
# Copy this file to .env and fill in your actual values
# Note: .env files are gitignored and should never be committed

# =====================================================================
# SUPABASE CREDENTIALS
# =====================================================================

# Public Supabase URL
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co

# =====================================================================
# NEW KEY SYSTEM (Recommended for all new projects)
# =====================================================================

# Publishable Key - Safe for client-side use (RLS enforced)
# Get from: https://app.supabase.com/project/_/settings/api
# Used by: recipe-import Edge Function
# Note: Add this to Supabase Edge Function secrets via:
#   supabase secrets set PUBLISHABLE_KEY=sb_publishable_...
PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret Key - SERVER ONLY, bypasses RLS (use with extreme caution)
# Get from: https://app.supabase.com/project/_/settings/api
# Used by: suggest-tags-batch Edge Function
# Note: Add this to Supabase Edge Function secrets via:
#   supabase secrets set SECRET_KEY=sb_secret_...
SECRET_KEY=sb_secret_your_key_here

# =====================================================================
# LEGACY KEY SYSTEM (For backward compatibility only)
# =====================================================================

# Public anonymous key (safe to expose in client-side code)
# Get from: https://app.supabase.com/project/_/settings/api
# Note: Only needed if you have Edge Functions that haven't been migrated yet
SUPABASE_ANON_KEY=eyJhbGc...your-anon-key

# Service role key (SERVER ONLY - bypasses Row Level Security)
# Get from: https://app.supabase.com/project/_/settings/api
# CRITICAL: Never expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your-service-role-key

# =====================================================================
# EDGE FUNCTION SECRETS
# =====================================================================

# OpenAI API Key (required for AI tag suggestions)
# Get from: https://platform.openai.com/api-keys
# Note: Add this to Supabase Edge Function secrets via:
#   supabase secrets set OPENAI_API_KEY=sk-proj-...
OPENAI_API_KEY=sk-proj-...your-openai-api-key

# =====================================================================
# DATABASE CONFIGURATION (for pg_cron HTTP calls)
# =====================================================================

# These settings must be configured via ALTER DATABASE SET commands:
#
# ALTER DATABASE postgres SET app.settings.edge_function_url = 'https://your-project.supabase.co/functions/v1';
# ALTER DATABASE postgres SET app.settings.supabase_anon_key = 'your-anon-key';
#
# Verify configuration:
# SELECT name, setting FROM pg_settings WHERE name LIKE 'app.settings%';
