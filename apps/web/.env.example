# Supabase Configuration
# Get these from https://app.supabase.com/project/_/settings/api

# Public URL - Safe to expose to client
NEXT_PUBLIC_SUPABASE_URL=https://lrelbxzvndbmfpxhgosd.supabase.co

# Publishable Key - Safe to expose to client (RLS enforced)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Secret Key - SERVER ONLY, NEVER expose to client (bypasses RLS)
SUPABASE_SECRET_KEY=your-secret-key-here

# Application Environment
NODE_ENV=development
